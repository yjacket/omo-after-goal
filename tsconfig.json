{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": [
			"ES2023"
		],
		"strict": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"skipLibCheck": true,
		"types": [
			"node",
			"bun"
		]
	},
	"include": [
		"extension/**/*.ts",
		"test/**/*.ts"
	]
}
